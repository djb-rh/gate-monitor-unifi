/*
 * Local, machine-specific config for gate-monitor.
 *
 * Copy this file to src/ha-config.h and fill in your own values. That copy is
 * gitignored, so the real address of your Home Assistant instance never lands
 * in this (public) repository -- and, unlike editing the .ino directly, your
 * local settings survive a pull without showing up as a dirty working tree.
 */

#pragma once

// Local IP or hostname of your Home Assistant instance, used only for the
// outbound button-press webhooks. A hostname works -- the Photon resolves it.
#define HA_HOST "192.168.1.50"

// Optional; defaults to 8123 if you leave this out.
// #define HA_PORT 8123
